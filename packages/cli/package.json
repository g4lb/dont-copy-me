    "@dont-copy-me/core": "workspace:*",
    "@dont-copy-me/framework-vite": "workspace:*",
    "@dont-copy-me/reporter": "workspace:*",
    "@dont-copy-me/shield": "workspace:*",
    "@dont-copy-me/verify": "workspace:*",
    "commander": "^15.0.0"
  }
}
