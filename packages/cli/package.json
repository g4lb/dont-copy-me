{
  "name": "dont-copy-me",
  "version": "0.1.0",
  "description": "Honest rights notices for people and AI agents. CLI (dcm) for Don't Copy Me.",
  "type": "module",
  "license": "MIT",
  "author": "g4lb <galevgi@gmail.com>",
  "keywords": [
    "copyright",
    "rights-notice",
    "tdm",
    "ai-agents",
    "clone",
    "vite"
  ],
  "bin": {
    "dcm": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
